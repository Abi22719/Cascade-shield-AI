# CascadeShield AI Backend Configuration
DATABASE_PATH=./cascadeshield.db
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Anomaly Detection Settings
ISOLATION_FOREST_CONTAMINATION=0.08
ISOLATION_FOREST_RANDOM_STATE=42

# Default Thresholds
THRESHOLD_CPU_WARNING=75.0
THRESHOLD_CPU_CRITICAL=90.0
THRESHOLD_MEMORY_WARNING=80.0
THRESHOLD_MEMORY_CRITICAL=95.0
THRESHOLD_LATENCY_WARNING=500.0
THRESHOLD_LATENCY_CRITICAL=1000.0
THRESHOLD_ERROR_RATE_WARNING=5.0
THRESHOLD_ERROR_RATE_CRITICAL=10.0
